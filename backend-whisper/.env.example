# Copy this file to .env and adjust for your homelab setup.

# faster-whisper model size, or a Hugging Face/CTranslate2 model id/path.
WHISPER_MODEL_SIZE=large-v3

# "cuda" or "cpu".
WHISPER_DEVICE=cuda

# "float16" (~6GB VRAM, highest accuracy) or "int8_float16" (~3GB VRAM,
# small accuracy tradeoff — a good choice if sharing a GPU with another
# model, e.g. running alongside ../backend/'s Qwen3-ASR container).
WHISPER_COMPUTE_TYPE=float16

# Reject uploads larger than this (bytes). Default: 300MB.
WHISPER_MAX_UPLOAD_BYTES=314572800

# Bearer token the app must send as `Authorization: Bearer <token>`. Leave
# empty for LAN-only / trusted-network use; set this before exposing the
# server past your homelab network (e.g. via a reverse proxy / tunnel).
WHISPER_API_TOKEN=

# Scratch directory for uploaded audio before transcription.
WHISPER_WORK_DIR=/tmp/kajian-whisper

# --- Speaker embedding (/embed-speaker) -------------------------------------
# Path to the sherpa-onnx speaker embedding model (baked into the image at
# build time — see Dockerfile). Only override if using a different
# checkpoint than the default CAM++ bilingual model.
WHISPER_SPEAKER_EMBEDDING_MODEL_PATH=/srv/models/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx

# "cpu" (default) or "cuda". In practice Whisper large-v3 at float16
# leaves too little VRAM headroom on this card for the CUDA provider (see
# config.py's comment) — cuda is available and matches this image's
# CUDA 12/cuDNN 9 stack, but needs Whisper's footprint reduced first (or
# the ONNX Runtime CUDA session tuned) to actually fit. Can also be set
# per-request via /embed-speaker's `provider` form field.
WHISPER_SPEAKER_EMBEDDING_PROVIDER=cpu
