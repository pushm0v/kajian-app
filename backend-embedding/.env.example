# Copy this file to .env and adjust for your homelab setup.

# Which baked-in checkpoint to use: "campplus" or "eres2netv2".
#
# campplus (default) — CAM++ bilingual zh+en, ~28MB, 192-dim. The only
#   multilingual checkpoint in sherpa-onnx's model zoo; every ERes2Net
#   variant there is zh-cn only, and WeSpeaker/NeMo options are
#   English/VoxCeleb only. Given this app's Indonesian audio (with Arabic
#   quotation), and benchmark data showing 8-23 point EER degradation on
#   cross-language trials for monolingual models, this is the safe default.
#
# eres2netv2 — ERes2NetV2 zh-cn, ~71MB, 192-dim. Stronger architecture and
#   better scores on Chinese, but trained zh-cn only. Baked into the image
#   so you can A/B it against campplus on real kajian recordings — which
#   generalizes better to Indonesian is an empirical question, not one the
#   benchmarks answer. Switch per-request via /embed-speaker's `model`
#   form field to compare without restarting.
EMBEDDING_MODEL=campplus

# Override to use a checkpoint outside the two baked in above. Takes
# precedence over EMBEDDING_MODEL when set.
# EMBEDDING_MODEL_PATH=/srv/models/your-model.onnx

# "cuda" (default) or "cpu". This service has a dedicated GPU, which is the
# reason it exists — when embedding shared a card with Whisper large-v3 it
# had to run on CPU (~93s for a 44-minute recording) because Whisper's
# float16 weights left under 0.5GB free. Set to "cpu" to fall back without
# a rebuild; also overridable per-request via /embed-speaker's `provider`.
EMBEDDING_PROVIDER=cuda

# CPU threads for provider=cpu (ignored for cuda). Defaults to all
# available cores — this is a single-request-at-a-time post-processing
# step, not concurrent-traffic serving.
# EMBEDDING_NUM_THREADS=4

# Reject uploads larger than this (bytes). Default: 300MB.
EMBEDDING_MAX_UPLOAD_BYTES=314572800

# Bearer token the caller must send as `Authorization: Bearer <token>`.
# Leave empty for LAN-only / trusted-network use; set this before exposing
# the server past your homelab network. Must match backend-core's
# EMBEDDING_BACKEND_TOKEN.
EMBEDDING_API_TOKEN=

# Scratch directory for uploaded audio before decoding.
EMBEDDING_WORK_DIR=/tmp/kajian-embedding
