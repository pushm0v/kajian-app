# Copy this file to .env and adjust for your homelab setup.

# Hugging Face model id. Default is Qwen2.5-7B-Instruct at AWQ 4-bit
# (~5.5GB of weights) — chosen for Indonesian/Malay/English/Arabic
# coverage and reliable JSON adherence, not general benchmark standing.
# See app/config.py's MODEL_ID comment for why not Llama at this size.
NOTES_MODEL_ID=Qwen/Qwen2.5-7B-Instruct-AWQ
NOTES_QUANTIZATION=awq

# Fraction of the GPU vLLM may reserve. Deliberately well below the 0.8
# the ASR backend uses, because this card is SHARED with
# ../backend-embedding/ — vLLM takes its share upfront and never gives it
# back, while the embedding service's ONNX Runtime CUDA session allocates
# on demand and needs room left over. Raise only if embedding moves off
# this card.
NOTES_GPU_MEMORY_UTILIZATION=0.55

# Context window. A 45-minute kajian is roughly 8-12k tokens; longer
# transcripts are truncated head-first (see app/notes_model.py).
NOTES_MAX_MODEL_LEN=16384

# Cap on generated notes length.
NOTES_MAX_TOKENS=1500

# Near-greedy: notes should be faithful, not creative, and low temperature
# also makes JSON output far more reliable.
NOTES_TEMPERATURE=0.2

# Skip vLLM's torch.compile/CUDA-graph capture at startup. Defaults true —
# the ASR backend hit repeated startup segfaults with compilation enabled
# on this GPU/driver. Trades throughput for a startup that completes,
# which is the right trade for a once-per-session workload.
NOTES_ENFORCE_EAGER=true

# Bearer token the caller must send as `Authorization: Bearer <token>`.
# Leave empty for LAN-only use; must match backend-core's
# NOTES_BACKEND_TOKEN if set.
NOTES_API_TOKEN=
