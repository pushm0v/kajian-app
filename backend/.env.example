# Copy this file to .env and adjust for your homelab setup.

# Hugging Face model id. Change to Qwen3-ASR-0.6B for lower VRAM use.
ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B

# Fraction of GPU memory vLLM is allowed to reserve. Both official Qwen3-ASR
# vLLM examples use 0.8; lower this on a GPU shared with other workloads.
ASR_GPU_MEMORY_UTILIZATION=0.8

# Skip vLLM's torch.compile/CUDA-graph capture at startup. Defaults to
# true — this deploy's GPU/driver combo segfaults inside vLLM's Inductor
# compile pipeline with compilation enabled (seen on two separate vLLM
# versions). Set to false to re-enable compilation if this is ever
# revisited (e.g. after a driver/toolkit upgrade).
ASR_ENFORCE_EAGER=true

# Attention backend for the audio ENCODER specifically (separate from the
# decoder LM's attention backend — no encoder-only override otherwise).
# Defaults to "TORCH_SDPA" (plain PyTorch attention, no custom kernel).
# Both FLASH_ATTN (vLLM's default) and TRITON_ATTN segfaulted the
# encoder's dummy/profiling forward pass at startup on this GPU (RTX
# 3080 Ti / Ampere) — FLASH_ATTN reproduced on two independent model
# implementations (ruling out an application bug), and TRITON_ATTN
# crashed with a different signature, inside PyTorch's own operator
# dispatcher right as Triton's JIT kernels loaded. See app/config.py's
# comment for the full history. Leave empty to let vLLM pick its own
# default.
ASR_MM_ENCODER_ATTN_BACKEND=TORCH_SDPA

# Caps vLLM's KV cache sizing to this many tokens instead of the model's
# full 65536 max_position_embeddings — on a 12GB card there isn't enough
# free VRAM after model weights + encoder buffers to fit a 65536-token KV
# cache (engine startup fails with a clear ValueError otherwise: "7.0 GiB
# KV cache is needed, which is larger than the available KV cache memory
# (1.75 GiB)"). 16384 alone was still too tight (vLLM's own reported
# ceiling on this card was 16352 — 16384 failed the same check by a
# hair); 8192 leaves real margin below that ceiling while still
# comfortably covering a single ~30s audio chunk plus generation.
ASR_MAX_MODEL_LEN=8192

# Chunk size used both to stay under the model's ~20min/call limit and to
# produce approximate segment timestamps (Qwen3-ASR has no built-in
# timestamps — see backend/README.md for why).
ASR_CHUNK_SECONDS=30
ASR_CHUNK_OVERLAP_SECONDS=1

# How many chunks are submitted to vLLM per generate() call during batch
# transcription. Higher amortizes per-call dispatch overhead better (fewer
# round-trips for a long recording), but each request in a batch holds its
# own KV cache slot concurrently, and this backend is already tight on
# VRAM (see ASR_MAX_MODEL_LEN above). 8 is a conservative starting point.
ASR_TRANSCRIBE_BATCH_SIZE=8

# Reject uploads larger than this (bytes). Default: 300MB.
ASR_MAX_UPLOAD_BYTES=314572800

# Bearer token required on both the /transcribe endpoint (Authorization
# header) and the /transcribe/stream WebSocket (?token=... query param,
# since bearer headers don't apply cleanly to WS handshakes). Leave empty
# for LAN-only / trusted-network use; set this before exposing the server
# past your homelab network (e.g. via a reverse proxy / tunnel).
ASR_API_TOKEN=

# Scratch directory for uploaded audio before/while decoding.
ASR_WORK_DIR=/tmp/kajian-asr

# --- Live streaming (/transcribe/stream) -----------------------------------
# These control the streaming decode loop in asr_model.py (chunk size and
# prefix-rollback strategy). Defaults match the official Qwen3-ASR streaming
# example. See backend/README.md for what each one controls before changing
# them.
ASR_STREAM_CHUNK_SIZE_SEC=2.0
ASR_STREAM_UNFIXED_CHUNK_NUM=2
ASR_STREAM_UNFIXED_TOKEN_NUM=5
